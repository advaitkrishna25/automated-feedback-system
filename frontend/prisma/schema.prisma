generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Feedback {
  id                Int      @id @default(autoincrement())
  transcript        String
  sentiment         String
  emotion           String
  satisfactionScore Int
  urgencyLevel      String
  followUpRequired  Boolean
  summary           String
  createdAt         DateTime @default(now())
}